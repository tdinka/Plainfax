# ---- Required ----
# Postgres connection string (Railway gives you one). Same idea as Recipe Box.
DATABASE_URL="postgresql://user:password@host:port/railway"
# The public web address of the app. Local: http://localhost:3000
APP_URL="http://localhost:3000"

# ---- Fax sending ----
# "mock" = simulated fax line (default, costs nothing). "telnyx" = real faxes.
FAX_PROVIDER="mock"
# Only needed when FAX_PROVIDER="telnyx" (all from the Telnyx portal):
TELNYX_API_KEY=""
TELNYX_CONNECTION_ID=""      # the Fax Application's ID
TELNYX_FROM_NUMBER=""        # your Telnyx number, like +12125550123
TELNYX_PUBLIC_KEY=""         # for checking webhooks really come from Telnyx

# ---- Payments ----
# Leave blank to use simulated payments (no Stripe account needed).
# Use test keys (sk_test_...) first, live keys (sk_live_...) only at go-live.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""     # whsec_... from the Stripe webhook settings

# Used to anonymize visitor IPs for the abuse limit. Any long random text.
IP_SALT="change-me-to-random-text"
